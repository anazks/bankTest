      "name": "1. Direct BG - Authenticate",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-ibm-client-id",
            "value": "{{client_id}}",
            "type": "text"
          },
          {
            "key": "x-ibm-client-secret",
            "value": "{{client_secret}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{bg_base_url}}/autenticacion/autenticar",
          "host": [
            "{{bg_base_url}}"
          ],
          "path": [
            "autenticacion",
            "autenticar"
          ]
        },
        "description": "Obtain access token from Banco General Conexión BG"
      },
      "response": []
    },
    {
