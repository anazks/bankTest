          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{bg_base_url}}/h2h/saldos?numeroCuenta=0401976351601",
          "host": [
            "{{bg_base_url}}"
          ],
          "path": [
            "h2h",
            "saldos"
          ],
          "query": [
            {
              "key": "numeroCuenta",
              "value": "0401976351601",
              "description": "Normalized account number without dashes"
            }
          ]
        },
        "description": "Query account balance using Bearer token"
      },
      "response": []
    },
